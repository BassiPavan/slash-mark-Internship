        <h3 class="feature-title">HexBreath Upper</h3>
        <p class="feature-desc">Engineered mesh with hexagonal ventilation channels keeps your feet dry through the longest sessions.</p>
      </div>
      <div class="feature-card reveal">
        <div class="feature-num">03</div>
        <div class="feature-icon">🔒</div>
        <h3 class="feature-title">LockFit System</h3>
        <p class="feature-desc">Adaptive lacing hugs the foot's natural shape. Zero slippage. Maximum lockdown. Pure confidence.</p>
      </div>
    </div>
  </section>
 
  <!-- PRODUCT SHOWCASE -->
  <section class="showcase" id="shop">
    <p class="section-label reveal">Shop the Collection</p>
    <h2 class="section-title reveal">Pick Your<br>Weapon.</h2>
    <div class="products-grid">
 
      <div class="product-card reveal">
