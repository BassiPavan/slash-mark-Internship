      <span class="marquee-item"><span class="marquee-dot"></span> 60-Day Returns</span>
      <span class="marquee-item"><span class="marquee-dot"></span> Sustainably Crafted</span>
      <span class="marquee-item"><span class="marquee-dot"></span> Limited Edition Drops</span>
      <span class="marquee-item"><span class="marquee-dot"></span> Carbon-Neutral by 2027</span>
    </div>
  </div>
 
  <!-- FEATURES -->
  <section class="section" id="features">
    <p class="section-label reveal">Why AURA</p>
    <h2 class="section-title reveal">Built Different.<br>By Design.</h2>
    <div class="features-grid">
      <div class="feature-card reveal">
        <div class="feature-num">01</div>
        <div class="feature-icon">⚡</div>
        <h3 class="feature-title">AuraFoam™ Midsole</h3>
